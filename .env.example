# WhatsApp Cloud API (Meta Graph API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Pre-launch safety valve — when set, every outgoing email redirects here instead of the
# real customer/vendor, with the original recipient prefixed onto the subject line for
# review. Unset (leave blank) once the app has actually launched.
EMAIL_TEST_MODE_RECIPIENT=
